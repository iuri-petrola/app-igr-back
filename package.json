{
  "name": "posso-orar-por-voce-backnodejs",
  "version": "1.0.0",
  "description": "API para fotos e videos do Posso Orar Por Voce",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:admin:upsert": "ts-node prisma/UpsertAdmin.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prd": "rm -rf dist/ && tsc && node dist/index.js"
  },
  "engines": {
    "node": ">=18.20.8"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "prisma": "^6.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.3.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
