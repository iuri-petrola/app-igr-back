generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Photo {
  id         Int      @id @default(autoincrement())
  title      String
  imageUrl   String
  instagramUrl String?
  ministerio String
  uploadedAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@map("photos")
}


model AdminUser {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@map("admin_users")
}

model Pedido {
  id          Int      @id @default(autoincrement())
  nome        String
  contato     String?
  pedido      String
  enviadoPara String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("pedidos")
}

model Usuario {
  id         Int         @id @default(autoincrement())
  nome       String
  celular    String      @unique
  email      String?
  inscricoes Inscricao[]
  convites   ConviteInscricao[]
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)

  @@map("usuarios")
}

model Evento {
  id                  Int         @id @default(autoincrement())
  titulo              String
  descricao           String?
  local               String?
  dataEvento           DateTime      @db.Timestamptz(3)
  prazoInscricao       DateTime?     @db.Timestamptz(3)
  inscricoesAbertas    Boolean     @default(true)
  inscricoes           Inscricao[]
  convites             ConviteInscricao[]
  createdAt            DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @db.Timestamptz(3)

  @@map("eventos")
}

model Inscricao {
  id         Int      @id @default(autoincrement())
  eventoId   Int
  usuarioId  Int
  evento     Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([eventoId, usuarioId])
  @@map("inscricoes")
}

model ConviteInscricao {
  id         Int       @id @default(autoincrement())
  eventoId   Int
  usuarioId  Int
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  usedAt     DateTime? @db.Timestamptz(3)
  evento     Evento    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([eventoId, usuarioId])
  @@map("convites_inscricao")
}
